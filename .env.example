# Supabase project settings. These values are safe for browser use when RLS is enabled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: public VAPID key enabling background Web Push (see README → Notifications).
# VITE_VAPID_PUBLIC_KEY=

# Optional: TURN relay so calls work behind strict NATs (see README → Calls).
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
